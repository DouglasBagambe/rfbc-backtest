# Permanent gateway, feature validation only. AUTO remains unavailable.
PYTHONPATH=monitor
DNB_REQUIRE_DURABLE=1
DNB_DATABASE_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# Secret URL, never commit the actual value:
DNB_DATABASE_URL=<private-postgres-url>
FX101_MT5_BRIDGE_ENABLED=1
FX101_MT5_EXECUTION_MODE=SHADOW
FX101_MT5_KILL_SWITCH=1
FX101_MT5_TRUST_PROXY=1
# Distinct permanent-service secret; never commit actual value:
FX101_MT5_BRIDGE_TOKEN=<private-64-lowercase-hex>
# Effective defaults; alerts are staged, not commissioned:
DNB_MANUAL_ALERTS_ENABLED=0
FX101_LEGACY_OVERLAYS=0
RFBC_EXECUTION_ENABLED=0
