# Isolated service settings. This is NOT an AUTO deployment.
PYTHONPATH=monitor
FX101_MT5_BRIDGE_ENABLED=1
FX101_MT5_EXECUTION_MODE=SHADOW
FX101_MT5_KILL_SWITCH=1
FX101_MT5_TRUST_PROXY=1
FX101_DB_PATH=/tmp/fx101-shadow.sqlite3
# Set via Render secret settings, never in GitHub:
# FX101_MT5_BRIDGE_TOKEN=<64 lowercase hex characters from secrets.token_hex(32)>
# SQLite on a free Render service is ephemeral. No AUTO may use this setup.
# No MT5 trading password is used by this application.
